# ---- Cameras ----
# Add as many as you like: CAMERA_1_*, CAMERA_2_*, CAMERA_3_* ... There is no
# upper limit, and the numbers don't have to be contiguous.
#
# Each entry is a host + channel pair, which covers both setups:
#   * standalone cameras -> a different HOST per camera, CHANNEL stays 0
#   * one NVR            -> the same HOST, a different CHANNEL per camera
#
# USER / PASSWORD / STREAM are optional per camera and fall back to the shared
# REOLINK_* values below, so an NVR only needs its credentials stated once.

CAMERA_1_NAME=front yard
CAMERA_1_HOST=192.168.1.50
CAMERA_1_CHANNEL=0

CAMERA_2_NAME=driveway
CAMERA_2_HOST=192.168.1.51
CAMERA_2_CHANNEL=0

# Example of a second channel on the same NVR instead:
# CAMERA_2_NAME=side gate
# CAMERA_2_HOST=192.168.1.50
# CAMERA_2_CHANNEL=1

# Shared credentials, used by any camera that doesn't override them
REOLINK_USER=admin
REOLINK_PASSWORD=changeme
# main = full res (better detail), sub = low res (much less disk per camera)
REOLINK_STREAM=main

# ---- Capture window ----
# Seconds of footage kept before the trigger (dogs squat fast)
PRE_ROLL_SECONDS=30
# Seconds recorded after the trigger (time for an owner to bag it)
POST_ROLL_SECONDS=120
# How long to retain raw rolling segments. Disk use is roughly
#   cameras x retention x bitrate -- lower this if you run many cameras.
SEGMENT_RETENTION_MINUTES=20

# ---- Models ----
ANTHROPIC_API_KEY=
# Posture gate. "ollama" = free local VLM (default), "haiku" = Claude Haiku 4.5, "off" = skip
GATE_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
# Final verdict model. Set to "ollama" to run the whole pipeline for free.
VERDICT_MODEL=claude-opus-5
# Skip the free local YOLO stage even if ultralytics is installed
DISABLE_LOCAL_DETECTOR=false
# How many events may be analyzed at once across ALL cameras. Raise it if you
# have GPU headroom; keep it low so simultaneous triggers don't thrash.
MAX_CONCURRENT_ANALYSES=2

# ---- Alerts ----
# ntfy.sh push: pick an unguessable topic, subscribe in the ntfy phone app
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ---- Server ----
HOST=127.0.0.1
PORT=8420
